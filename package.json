{
  "name": "mikrotik-home-network",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "typecheck": "tsc -b",
    "gen:remix-content": "node scripts/generate-remix-content.mjs",
    "remix:assets": "node scripts/build-remix-assets.mjs",
    "cf:build": "pnpm gen:remix-content && pnpm remix:assets",
    "cf:deploy": "wrangler deploy && node scripts/purge-zone.mjs",
    "dev:remix": "node --import remix/node-tsx server/node.ts",
    "dev:remix-workerd": "wrangler dev -c wrangler.remix.jsonc"
  },
  "dependencies": {
    "hast-util-to-string": "^3.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remix": "3.0.0-beta.5",
    "shiki": "^4.3.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260716.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^25.0.1",
    "esbuild": "^0.27.7",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.111.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
