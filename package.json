{
  "name": "mikrotik-home-network",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0",
    "rss": "node scripts/generate-rss.mjs",
    "build": "pnpm rss && react-router build",
    "preview": "vite preview --host 0.0.0.0 --outDir build/client",
    "typecheck": "react-router typegen && tsc -b",
    "gen:remix-content": "node scripts/generate-remix-content.mjs",
    "remix:assets": "node scripts/build-remix-assets.mjs",
    "cf:build": "pnpm gen:remix-content && pnpm remix:assets",
    "cf:deploy": "wrangler deploy && node scripts/purge-zone.mjs",
    "dev:remix": "node --import remix/node-tsx server/node.ts",
    "dev:remix-workerd": "wrangler dev -c wrangler.remix.jsonc"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-router/node": "^7.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hast-util-to-string": "^3.0.1",
    "isbot": "^5",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.15.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remix": "3.0.0-beta.5",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260716.1",
    "@react-router/dev": "^7.15.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.7",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.111.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
