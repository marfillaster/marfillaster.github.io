// Production worker `blog` (blog.homestack.space) — the Remix 3 app, live SSR
// with version-keyed edge caching (Phase 5 cutover; docs/remix3-migration-plan.md).
// Deployed by the Cloudflare Git integration on push to main:
//   build:  pnpm cf:build   (content module + fingerprinted assets)
//   deploy: pnpm cf:deploy  (wrangler deploy)
// Secrets GA_SERVICE_ACCOUNT_KEY + ADMIN_RESYNC_TOKEN live on the worker and
// persist across deploys (`wrangler secret put`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "workers/remix-app.ts",
  // ctx.exports (the loopback to the `Site` entrypoint) is default-on from
  // compatibility date 2025-11-17, so no explicit flag is needed. Everything
  // else this date turns on is either nodejs_compat-gated (off here) or
  // additive.
  "compatibility_date": "2026-07-24",
  // No nodejs_compat — the rendering path is Web-API only (see
  // docs/remix3-spike-report.md).
  // Workers Cache in front of both entrypoints — the gateway's layer answers
  // canonical URLs without running anything, `Site`'s layer collapses the
  // rewritten ones onto a shared entry (workers/remix-app.ts). Cache keys
  // include the Worker version (cross_version_cache stays off — version keying
  // is what makes "a deploy needs no purge" true), so a deploy makes every
  // previous entry unreachable.
  //
  // Deliberately no top-level `cache` block: both entrypoints set their own
  // value, so it would never be read — and enabling caching Worker-wide is
  // what makes otherwise-free static asset requests bill at the standard
  // request rate. Whether the asset path follows the top-level flag or "any
  // entrypoint caches" is undocumented; listing only entrypoints is the
  // configuration that can't cost more than it has to.
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": true } },
    "Site": { "type": "worker", "cache": { "enabled": true } }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./.remix-assets",
    "not_found_handling": "none"
  },
  // Per-IP ceiling on unmatched paths (app/app.tsx defaultHandler). The
  // namespace id is an arbitrary integer scoping the counter, not a resource.
  // 30 per 10s is far above what a reader generates and far below a spray.
  "ratelimits": [
    {
      "name": "NOT_FOUND_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 10 }
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "kv_namespaces": [
    {
      "binding": "PAGE_VIEWS",
      "id": "90321c43ce5e4817a332c0c639c474a2"
    }
  ],
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "blog-comments",
      "database_id": "8b53e206-d2c7-4c41-8f22-d8001c9832ea",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GA_PROPERTY_ID": "535474441",
    "COMMENTS_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAD40Ccaaxq75pR5k"
  },
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md", "**/*.mdx"],
      "fallthrough": true
    }
  ]
}
