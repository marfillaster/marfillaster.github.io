{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "outDir": "../.react-router/tsc-workers",
    "declarationDir": "../.react-router/tsc-workers",
    "emitDeclarationOnly": true
  },
  "include": ["**/*.ts"],
  // The Remix worker files belong to the app project (app/tsconfig.json),
  // which compiles JSX against remix/ui and NodeNext resolution.
  "exclude": [
    "remix-app.ts",
    "remix-content.generated.ts",
    "cache-digests.generated.ts",
    "remix-env.d.ts"
  ]
}
