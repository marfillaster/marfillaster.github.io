{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "outDir": "../.react-router/tsc-workers",
    "declarationDir": "../.react-router/tsc-workers",
    "emitDeclarationOnly": true
  },
  "include": ["**/*.ts"]
}
