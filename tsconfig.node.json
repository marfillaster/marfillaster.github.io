{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "outDir": ".react-router/tsc-node",
    "declarationDir": ".react-router/tsc-node",
    "emitDeclarationOnly": true
  },
  "include": ["src/lib/render-markdown.ts", "src/lib/series.ts"]
}
