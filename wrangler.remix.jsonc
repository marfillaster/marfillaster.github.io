// Remix 3 app worker — Phase 2 spike/dev config. Run locally with
// `pnpm dev:remix-workerd`; NOT deployed (production stays on wrangler.jsonc
// until Phase 5 cutover).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-remix",
  "main": "workers/remix-app.ts",
  "compatibility_date": "2025-07-01",
  // ctx.exports (the loopback to the `Site` entrypoint) is default-on from
  // compatibility date 2025-11-17; this enables it without moving the date
  // across a year of unrelated flags.
  "compatibility_flags": ["enable_ctx_exports"],
  // No nodejs_compat — the rendering path is Web-API only (see
  // docs/remix3-spike-report.md).
  "assets": {
    "binding": "ASSETS",
    "directory": "./.remix-assets",
    "not_found_handling": "none"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Analytics (Phase 3). Placeholder KV id — `wrangler dev --local` uses
  // miniflare's local storage and never contacts this namespace; production
  // gets the real id at Phase 5 cutover. Secrets (GA_SERVICE_ACCOUNT_KEY,
  // ADMIN_RESYNC_TOKEN) come from .dev.vars locally; without them the app
  // serves stubbed stats.
  "kv_namespaces": [
    {
      "binding": "PAGE_VIEWS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "d1_databases": [
    {
      "binding": "COMMENTS_DB",
      "database_name": "blog-comments-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GA_PROPERTY_ID": "",
    "COMMENTS_ENABLED": "true",
    "COMMENTS_LOCAL_DEV": "true",
    "TURNSTILE_SITE_KEY": ""
  },
  "triggers": {
    "crons": ["0 18 * * *"]
  },
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md", "**/*.mdx"],
      "fallthrough": true
    }
  ]
}
